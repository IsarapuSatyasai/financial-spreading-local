   "source": [
    "# Financial Spreading - Local Test Run\n",
    "\n",
    "1. Ensure `.env` has `OPENAI_API_KEY`\n",
    "2. Put your PDF in `data/input/annual_report.pdf`\n",
    "3. Put the template in `data/templates/creditlens_template.xlsx`\n",
    "4. Run all cells."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from config import get_settings\n",
    "from src.graph.graph_workflow import build_graph\n",
    "from utils.helpers import ensure_dirs\n",
    "\n",
    "ensure_dirs()\n",
    "settings = get_settings()\n",
    "print(\"Settings loaded. Model:\", settings.openai_model)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "graph = build_graph()\n",
    "print(\"Graph compiled successfully.")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "initial_state = {\n",
    "    \"excel_path\": str(settings.template_path),\n",
    "    \"pdf_source\": str(settings.pdf_path),\n",
    "    \"output_path\": str(settings.output_path),\n",
    "    \"pdf_file_name\": \"annual_report.pdf\",\n",
    "}\n",
    "\n",
    "result = graph.invoke(initial_state)\n",
    "print(\"Done. Errors:\", result.get(\"errors\"))\n",
    "print(\"Answers count:\", len(result.get(\"answers\", [])))\n",
    "print(\"Output written to:\", settings.output_path)"
   ]
  }
 ],
